# Keystore Configuration for Release Signing
#
# IMPORTANT:
# - Copy this file to the root of your project as "keystore.properties"
# - Replace the placeholder values with your actual keystore credentials
# - NEVER commit keystore.properties to git!
# - Keep your passwords secure (use a password manager)

storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=duoplay
storeFile=AndroidRelease/keystore/duoplay-release.keystore
